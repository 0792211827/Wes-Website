# Copy to .env.local and fill in. Never commit .env.local (CLAUDE.md §4).
# `npm run dev` works with none of these set. A production build additionally
# needs a real site URL (see below); everything else stays optional.

# --- Site -------------------------------------------------------------------
# Canonical origin, no trailing slash. Overrides siteConfig.url. A production
# build FAILS without this (or a real `url` in src/config/site.ts) rather than
# silently shipping localhost canonicals and a localhost sitemap.
NEXT_PUBLIC_SITE_URL=

# Escape hatch: allows a local production build to fall back to
# http://localhost:3000 before a domain is chosen. Never set this in a real
# deploy.
# ALLOW_PLACEHOLDER_SITE_URL=1

# --- Analytics (Phase 1/4) --------------------------------------------------
# Absent value disables analytics entirely. See src/lib/analytics.ts.
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# --- Contact form (Phase 1) -------------------------------------------------
# TODO: delivery provider credentials for /api/contact.
CONTACT_TO_EMAIL=

# --- AI assistant (Phase 3) -------------------------------------------------
# Provider is selected at runtime; keys are read only inside src/lib/rag/.
# TODO: set the provider id and its key once a provider is chosen.
LLM_PROVIDER=
LLM_API_KEY=
EMBEDDING_MODEL=

# --- GitHub integration (Phase 4) -------------------------------------------
# Read-only token, public data only. Absent value falls back to static data.
GITHUB_TOKEN=
GITHUB_USERNAME=
