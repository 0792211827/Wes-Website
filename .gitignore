# (CLAUDE.md §4).
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code local overrides (machine-specific; agents/commands ARE committed)
.claude/settings.local.json

# personal source material — contains a phone number, must never be committed
# or moved into public/ (see docs/source-material.md)
Wesley_Nyamosi_Resume.pdf

# playwright-mcp scratch output
.playwright-mcp/
